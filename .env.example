# ==============================================
# CropCare AI Environment Configuration Template
# ==============================================

# Application Ports
PORT=5000
AI_SERVICE_PORT=8000
FRONTEND_PORT=5173

# Database (MongoDB)
# Provide a MongoDB connection URI (e.g., mongodb://localhost:27017/cropcare)
# If empty or unavailable, the backend seamlessly falls back to embedded/memory storage for testing and local dev.
MONGODB_URI=mongodb://localhost:27017/cropcare

# Security & Authentication
JWT_SECRET=cropcare_jwt_super_secure_development_secret_key_2026_xyz
JWT_EXPIRES_IN=7d

# AI Service Configuration
AI_SERVICE_URL=http://localhost:8000
MODEL_CHECKPOINT_PATH=ai-service/app/models/cropcare_model.pt
MODEL_METADATA_PATH=ai-service/app/models/model_meta.json
CONFIDENCE_THRESHOLD=0.65
UNCERTAINTY_ENTROPY_LIMIT=1.20

# Weather Provider Configuration
# Set WEATHER_API_KEY to enable OpenWeatherMap or compatible service.
# If omitted or unconfigured, the system uses the verified Open-Meteo public agronomic API or local cached seasonal fallback.
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Node Environment
NODE_ENV=development
